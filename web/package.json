{
  "name": "@ttspro/web",
  "version": "0.0.1",
  "private": true,
  "description": "Browser runtime for ttspro: same text frontend as Python, same model contract, ONNX Runtime Web.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "preparar": "node scripts/preparar-estaticos.mjs",
    "dev": "npm run preparar && vite",
    "build": "npm run preparar && vite build",
    "preview": "vite preview",
    "build:lib": "npm run preparar && vite build -c vite.lib.config.ts",
    "servir": "npm run preparar && node scripts/servir.mjs 8080"
  },
  "dependencies": {
    "espeak-ng": "^1.0.2",
    "onnxruntime-web": "^1.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
